# Ollama configuration (SQL generation LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Embedding model for pgvector RAG (must be available in Ollama)
EMBEDDING_MODEL=nomic-embed-text

# Analysis LLM — optional, leave blank to fall back to OLLAMA_MODEL
# Set ANALYSIS_MODEL only (no key) to use an Ollama-hosted model for analysis
# Set both ANALYSIS_MODEL + ANALYSIS_API_KEY for an OpenAI-compatible cloud API
# Examples (Ollama):  gemma4:31b-cloud, llama3.1:70b
# Examples (OpenAI):  gpt-4o  (with ANALYSIS_API_KEY=sk-...)
ANALYSIS_MODEL=
ANALYSIS_API_KEY=
# Set to true to enable chain-of-thought thinking mode (gemma4 and compatible models only)
ANALYSIS_THINKING=false

# PostgreSQL connection (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geospatial
DB_USER=geo
DB_PASSWORD=geo
